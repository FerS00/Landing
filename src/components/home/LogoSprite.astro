---
const logos = import.meta.glob('../../assets/logos/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const symbols = Object.entries(logos)
  .map(([path, source]) => {
    const name = path.match(/([^/]+)\.svg$/)?.[1];
    if (!name) return '';
    const cleaned = source
      .replace(/<\?xml[^>]*\?>/gi, '')
      .replace(/<!--[\s\S]*?-->/g, '')
      .trim();
    const root = cleaned.match(/^<svg\b([^>]*)>([\s\S]*?)<\/svg>$/i);
    if (!root) return '';
    const attributes = root[1] ?? '';
    const inner = root[2] ?? '';
    const viewBox = attributes.match(/\bviewBox="([^"]+)"/i)?.[1];
    if (!viewBox) return '';
    const fill = attributes.match(/\bfill="([^"]+)"/i)?.[1];
    const symbolId = `i-${name}`;
    const ids = new Set([...inner.matchAll(/\bid="([^"]+)"/g)].map((match) => match[1]));
    const body = inner
      .replace(/\bid="([^"]+)"/g, (_match, id: string) => `id="${symbolId}-${id}"`)
      .replace(/#([\w:.-]+)/g, (reference, id: string) =>
        ids.has(id) ? `#${symbolId}-${id}` : reference,
      );
    return `<symbol id="${symbolId}" viewBox="${viewBox}"${fill ? ` fill="${fill}"` : ''}>${body}</symbol>`;
  })
  .join('');
---

<svg class="logo-sprite" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" set:html={symbols} />

<style>
  .logo-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
