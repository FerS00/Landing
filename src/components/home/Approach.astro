---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section id="approach" class="approach wrap" aria-labelledby="approach-title">
  <div class="section-head reveal">
    <div>
      <p class="eyebrow">{t('approach.eyebrow')}</p>
      <h2 id="approach-title">
        {t('approach.titleFirst')}
        <br />
        <span class="grad-text">{t('approach.titleSecond')}</span>
      </h2>
    </div>
    <p class="intro">{t('approach.intro')}</p>
  </div>

  <div class="flow-scroll">
    <div
      class="flow reveal"
      id="flow"
      aria-label={t('approach.eyebrow')}
      data-request-valid={t('flow.requestValidText')}
      data-request-invalid={t('flow.requestInvalidText')}
      data-verdict-accept={t('flow.accept')}
      data-verdict-reject={t('flow.reject')}
    >
      <div class="wire" aria-hidden="true"></div>
      <div class="packet" id="flow-packet" aria-hidden="true"></div>
      <article class="node">
        <p class="node-label">{t('flow.entryLabel')}</p>
        <h3>{t('flow.entryTitle')}</h3>
        <p id="flow-request">{t('flow.requestValidText')}</p>
      </article>
      <article class="node">
        <p class="node-label">{t('flow.modelLabel')}</p>
        <h3>{t('flow.modelTitle')}</h3>
        <p class="code" id="flow-operation">
          add_sale(qty=3, price=40)
        </p>
      </article>
      <article class="node gate">
        <p class="node-label">{t('flow.checkLabel')}</p>
        <h3>{t('flow.checkTitle')}</h3>
        <p>{t('flow.checkDescription')}</p>
        <p class="verdict" id="flow-verdict" aria-live="polite"></p>
      </article>
      <article class="node">
        <p class="node-label">{t('flow.outputLabel')}</p>
        <h3>{t('flow.outputTitle')}</h3>
        <p>{t('flow.outputDescription')}</p>
      </article>
    </div>
  </div>

  <div class="flow-controls">
    <button class="chip" type="button" data-flow-valid="true">
      {t('flow.requestValid')}
    </button>
    <button class="chip" type="button" data-flow-valid="false">
      {t('flow.requestInvalid')}
    </button>
    <small>{t('run.hint')}</small>
  </div>

  <div class="themes">
    <article class="theme-card reveal">
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <rect x="4" y="10" width="16" height="11" rx="2" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
      </svg>
      <h3>{t('themes.offlineTitle')}</h3>
      <p>{t('themes.offlineDescription')}</p>
    </article>
    <article class="theme-card reveal">
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="m12 3 8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" />
        <path d="m9 12 2 2 4-4" />
      </svg>
      <h3>{t('themes.permissionsTitle')}</h3>
      <p>{t('themes.permissionsDescription')}</p>
    </article>
    <article class="theme-card reveal">
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5" />
      </svg>
      <h3>{t('themes.systemsTitle')}</h3>
      <p>{t('themes.systemsDescription')}</p>
    </article>
  </div>
</section>

<script>
  import { prefersReducedMotion } from '../../scripts/motion';

  const flow = document.querySelector<HTMLElement>('#flow');
  const nodes = [...(flow?.querySelectorAll<HTMLElement>('.node') ?? [])];
  const packet = document.querySelector<HTMLElement>('#flow-packet');
  const request = document.querySelector<HTMLElement>('#flow-request');
  const operation = document.querySelector<HTMLElement>('#flow-operation');
  const verdict = document.querySelector<HTMLElement>('#flow-verdict');
  const reduceMotion = prefersReducedMotion();
  let running = false;
  let autoStarted = false;

  function runFlow(valid: boolean): void {
    if (running || !flow || !packet || !request || !operation || !verdict) return;
    running = true;
    request.textContent = valid
      ? (flow.dataset.requestValid ?? '')
      : (flow.dataset.requestInvalid ?? '');
    operation.textContent = valid ? 'add_sale(qty=3, price=40)' : 'add_sale(qty=3, price=-40)';
    verdict.textContent = '';
    verdict.className = 'verdict';
    packet.classList.toggle('bad', !valid);

    const flowRect = flow.getBoundingClientRect();
    const stops = nodes.map((node) => {
      const rect = node.getBoundingClientRect();
      return rect.left - flowRect.left + rect.width / 2 - packet.offsetWidth / 2;
    });
    let index = 0;

    const advance = () => {
      nodes.forEach((node) => node.classList.remove('active'));
      nodes[index]?.classList.add('active');
      if (!reduceMotion) {
        packet.style.opacity = '1';
        packet.animate(
          [
            { transform: `translateX(${stops[Math.max(index - 1, 0)]}px)` },
            { transform: `translateX(${stops[index]}px)` },
          ],
          {
            duration: index === 0 ? 1 : 650,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            fill: 'forwards',
          },
        );
      }

      if (index === 2) {
        verdict.textContent = valid
          ? (flow.dataset.verdictAccept ?? '')
          : (flow.dataset.verdictReject ?? '');
        verdict.classList.add(valid ? 'ok' : 'no');
      }

      index += 1;
      if (index < (valid ? nodes.length : 3)) {
        window.setTimeout(advance, reduceMotion ? 300 : 900);
      } else {
        window.setTimeout(() => {
          nodes.forEach((node) => node.classList.remove('active'));
          packet.style.opacity = '0';
          running = false;
        }, 1600);
      }
    };

    advance();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-flow-valid]').forEach((button) => {
    button.addEventListener('click', () => runFlow(button.dataset.flowValid === 'true'));
  });

  if (flow && !reduceMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting) && !autoStarted) {
          autoStarted = true;
          observer.disconnect();
          window.setTimeout(() => runFlow(true), 500);
        }
      },
      { threshold: 0.2 },
    );
    observer.observe(flow);
  }
</script>

<style>
  .approach {
    padding-block: var(--space-24) 0;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
    align-items: flex-end;
    margin-bottom: var(--space-12);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-green);
    font: 500 0.78rem/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h2 {
    margin-top: var(--space-4);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .intro {
    max-width: 46ch;
    color: var(--color-muted-fg);
  }
  .flow-scroll {
    overflow: visible;
    padding: 0;
    scrollbar-color: var(--color-border-strong) transparent;
  }
  .flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    min-width: 0;
  }
  .node {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: transform 350ms var(--ease-out);
  }
  .node.active {
    transform: translateY(-5px);
    border-color: var(--color-green);
    box-shadow: 0 18px 38px -24px var(--color-green);
  }
  .node-label {
    color: var(--color-muted-fg);
    font: 500 0.7rem var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .node h3 {
    margin-block: 10px 8px;
    font-size: 1.2rem;
    line-height: 1.15;
  }
  .node > p:not(.node-label):not(.verdict) {
    color: var(--color-muted-fg);
    font-size: 0.92rem;
  }
  .node .code {
    color: var(--color-cyan) !important;
    font: 400 0.8rem var(--font-mono);
    overflow-wrap: anywhere;
  }
  .node.gate {
    border-width: 1.5px;
    border-color: transparent;
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      var(--grad-loop) border-box;
  }
  .node.gate .node-label {
    color: var(--color-green);
  }
  .verdict {
    height: 3em;
    overflow: hidden;
    margin-top: 12px;
    font: 500 0.78rem/1.5 var(--font-mono);
  }
  .verdict.ok {
    color: var(--color-ok);
  }
  .verdict.no {
    color: var(--color-danger);
  }
  .wire {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: 3%;
    left: 3%;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-border-strong) 0 6px,
      transparent 6px 12px
    );
  }
  .packet {
    position: absolute;
    z-index: 2;
    top: 50%;
    margin-top: -7px;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 20px var(--color-green);
    opacity: 0;
    pointer-events: none;
  }
  .packet.bad {
    background: var(--color-danger);
    box-shadow: 0 0 20px var(--color-danger);
  }
  .flow-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .chip {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--color-fg);
    cursor: pointer;
    font: 500 0.85rem var(--font-mono);
  }
  .chip:hover {
    border-color: var(--color-green);
    color: var(--color-green);
  }
  .flow-controls small {
    color: var(--color-muted-fg);
  }
  .themes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .theme-card {
    min-width: 0;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
  }
  .theme-card svg {
    width: 28px;
    height: 28px;
    margin-bottom: var(--space-4);
    color: var(--color-green);
  }
  .theme-card h3 {
    margin-bottom: var(--space-2);
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .theme-card p {
    color: var(--color-muted-fg);
    font-size: 0.93rem;
  }
  @media (max-width: 900px) {
    .themes {
      grid-template-columns: 1fr;
    }
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wire,
    .packet {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .flow {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .node.active {
      transform: none;
    }
  }
</style>
