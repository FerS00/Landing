---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { hasAnalyticsConfig } from '../lib/analytics';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const showConsent = hasAnalyticsConfig(
  import.meta.env.PUBLIC_GA_ID,
  import.meta.env.PUBLIC_CLARITY_ID,
);
---

<footer class="wrap">
  <p>{t('footer.copyright')}</p>
  <nav class="footer-links" aria-label={t('footer.aria')}>
    <a href={lang === 'es' ? '/faq/' : '/en/faq/'} data-open-dialog="faq">
      {t('footer.faq')}
    </a>
    <a href={lang === 'es' ? '/privacidad/' : '/en/privacy/'} data-open-dialog="privacy">
      {t('footer.privacy')}
    </a>
    {showConsent && (
      <button type="button" data-open-consent>
        {t('footer.preferences')}
      </button>
    )}
  </nav>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted-fg);
    font-size: 0.88rem;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .footer-links a,
  .footer-links button {
    min-height: 24px;
    color: inherit;
  }
  .footer-links button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-links a:hover,
  .footer-links button:hover {
    color: var(--color-green);
  }
</style>
